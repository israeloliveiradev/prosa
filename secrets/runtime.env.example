# Copie este arquivo para secrets/runtime.env e troque cada valor.
# O arquivo real fica fora do Git. O Compose lê env_file sem interpolar
# a senha, então $, aspas e crases permanecem literais.

POSTGRES_USER=prosa
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=prosa
REDIS_PASSWORD=troque-esta-senha

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Opcionais. Sem elas o checkout responde que o Stripe não está configurado.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Lista separada por vírgula. Esses e-mails ganham papel admin no login.
ADMIN_EMAILS=

# Correio de verdade. Mailjet (plano gratuito) tem prioridade: preencha
# MAILJET_API_KEY e MAILJET_API_SECRET. MAIL_FROM precisa ser um remetente
# validado no painel do Mailjet (Account settings → Sender addresses).
MAILJET_API_KEY=
MAILJET_API_SECRET=
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=Prosa <voce@seudominio.com>

# Origens extras do aplicativo web, além de APP_PUBLIC_URL e localhost:8081.
CORS_ORIGINS=
