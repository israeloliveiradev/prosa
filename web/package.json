{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/literata": "^0.4.3",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo/ui": "~57.0.20",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "@tanstack/query-sync-storage-persister": "^5.103.2",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-persist-client": "^5.103.2",
    "expo": "~57.0.25",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "framer-motion": "^14.14.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.74.0",
    "nativewind": "^4.2.1",
    "piper-tts-web": "^1.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.5.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "tokens": "node --no-warnings scripts/generate-tokens.ts",
    "prestart": "npm run tokens",
    "preweb": "npm run tokens",
    "prelint": "npm run tokens",
    "prebuild:web:e2e": "npm run tokens",
    "prebuild:web:smoke": "npm run tokens",
    "prebuild:web:inspect": "npm run tokens",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "metrics": "node scripts/ui-metrics.mjs --out ../docs/qa/metrics",
    "build:web:e2e": "node scripts/with-env.mjs EXPO_PUBLIC_API_URL=http://127.0.0.1:4173 npx expo export --platform web --output-dir dist-e2e",
    "build:web:smoke": "node scripts/with-env.mjs EXPO_PUBLIC_API_URL=http://127.0.0.1:3000 npx expo export --platform web --output-dir dist-smoke",
    "build:web:inspect": "node scripts/with-env.mjs EXPO_PUBLIC_API_URL=http://127.0.0.1:4174 EXPO_PUBLIC_DEV_UI=1 npx expo export --platform web --output-dir dist-inspect",
    "serve:inspect": "node e2e/helpers/serve.mjs --dist dist-inspect --port 4174 --api mock --seed learner",
    "test:unit": "node scripts/with-env.mjs PW_NO_SERVER=1 playwright test --project=unit",
    "e2e": "playwright test --project=mobile --project=desktop",
    "e2e:ui": "playwright test --ui",
    "e2e:smoke": "node scripts/with-env.mjs PW_SMOKE=1 playwright test --project=smoke",
    "e2e:report": "playwright show-report"
  },
  "private": true
}
