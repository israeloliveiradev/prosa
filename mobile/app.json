{
  "expo": {
    "name": "Prosa",
    "slug": "prosa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prosa",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#9A3412",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Prosa",
      "shortName": "Prosa",
      "lang": "pt",
      "themeColor": "#9A3412",
      "backgroundColor": "#FFF8F1",
      "description": "Uma lição de vinte minutos por dia."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Prosa usa o microfone para comparar sua pronúncia com a frase original."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
